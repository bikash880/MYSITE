# Copy this file to .env.local and fill in the values.

# MongoDB Atlas → your cluster → Connect → Drivers → copy the connection string.
# Replace <db_password> with your database user's password (URL-encode special characters).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=portfolio
# Database name inside the cluster (created automatically).
MONGODB_DB=portfolio

# Public URL of the deployed site (no trailing slash). Used for SEO, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Expo access token if you enable "enhanced push security" for the mobile app.
EXPO_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Admin (server-only). ADMIN_EMAIL is the ONLY email that can register (once, at /admin/register)
# and sign in. The password is chosen during registration and stored only as a bcrypt hash in MongoDB.
ADMIN_EMAIL=you@example.com
# Encrypts + authenticates admin session tokens (JWE A256GCM). 32+ random chars. Generate it with:
#   npm run admin:password -- --secret-only        (add --rotate to replace it and sign everyone out)
AUTH_SECRET=replace-me-with-the-output-of-npm-run-admin-password
# Keeps Server Action IDs stable across restarts and deploys (prevents "Server Action not found").
# 32 random bytes, base64 — also generated by:  npm run admin:password -- --secret-only
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Automatic session expiry (optional): absolute lifetime and inactivity timeout.
SESSION_MAX_AGE_HOURS=12
SESSION_IDLE_MINUTES=60

# Email delivery for the login verification code (OTP).
# Gmail: smtp.gmail.com / 465 with an App Password (https://myaccount.google.com/apppasswords).
# In development, if SMTP_PASS is empty the code is printed in the server terminal instead.
# In production, admin login is blocked until SMTP is configured.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=
SMTP_FROM=Portfolio Admin <you@example.com>
