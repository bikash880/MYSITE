# The website's URL — the app talks to its REST API (which owns the MongoDB Atlas connection).
# Local development: use your computer's LAN IP (not "localhost") so your phone can reach it,
#   e.g. http://192.168.0.173:3000  (run `npm run dev` in the website folder)
# Production: your deployed site, e.g. https://your-site.vercel.app
EXPO_PUBLIC_API_URL=https://your-site.vercel.app
 